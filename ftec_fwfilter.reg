Windows Registry Editor Version 5.00

; Default device PID 0020 (patched by setup_ftec_fwfilter.sh --pid).
; RimType 0x0b (Podium Hub) is only a fallback; with hid_fanatec loaded the
; driver syncs it from sysfs.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Enum\USB#VID_0EB7&PID_0020#001#6&12345678&0&000]
"BaseAccessories"=dword:00000000
"BaseType"=dword:00000001
"DeviceModule"=dword:00000015
"FirmwareVersion"=dword:00000001
"HardwareExtFlags"=dword:00000000
"PedalsType"=dword:00000000
"RimType"=dword:0000000b
"SystemConfig"=dword:0000001c
"SystemReport"=hex:00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,00,00,00,00,00,00,00,01,00,00,00,00,00,00,00,00,00,00,00,00,00,\
  00,00,00,00,02,00,00,00,00,00,00,00,00,00,00,00,00,00,00
"WheelRotation"=dword:00000000
"WheelType"=dword:00000011
